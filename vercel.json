{
  "redirects": [
    {
      "source": "/internship",
      "destination": "https://flolabs.international",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "destination": "https://www.flolabsrd.com/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "flomadlabs.com"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "https://www.flolabsrd.com/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "www.flomadlabs.com"
        }
      ]
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}
